# SpiritOS server env

PORT=3001
NODE_ENV=development

# Prisma — SQLite for dev. Switch to "postgresql://..." + update
# prisma/schema.prisma to use Postgres in production.
DATABASE_URL=file:./spiritos.db

# REQUIRED. Long random string for express-session.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Filesystem root for the File Explorer app. Empty defaults to the user's
# home directory. Set to ./demo-filesystem to use the bundled demo data.
FS_ROOT=
MAX_TREE_DEPTH=4
TREE_CACHE_TTL=5000

# Terminal limits
TERMINAL_TIMEOUT=15000
TERMINAL_MAX_OUTPUT=50000

# CORS
CLIENT_URL=http://localhost:5173

# ─── IRIS Engine (Primary AI — Gemini) ──────────────────────────────────────
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Groq for faster intent routing
GROQ_API_KEY=

# Optional: Tavily for web search
TAVILY_API_KEY=

# Optional: OpenRouter for free-model fallback (https://openrouter.ai/)
# Uses 9+ free LLMs as fallback when Gemini hits rate limits
OPENROUTER_API_KEY=

# Engine config
AI_PRIMARY_ENGINE=iris           # 'iris' (Gemini primary) or 'spirit' (offline only)
AI_FALLBACK_TIMEOUT_MS=10000     # Fall back after this many ms
ENABLE_PERSISTENT_MEMORY=true    # Store user memories across sessions

# FALLBACK CHAIN: Gemini → OpenRouter free models → Spirit offline
# Without any API keys, the system uses the offline Spirit engine (lib/spirit.js).

# ─── Gnani Speech APIs (Prisma STT + Timbre TTS) ────────────────────────────
# Get the single API key from the Gnani APIs dashboard. Never expose it to Vite.
GNANI_API_KEY=replace-with-your-gnani-api-key
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_REST_PATH=/stt/v3
GNANI_STT_WS_PATH=/stt/v3/stream
GNANI_TTS_REST_PATH=/api/v1/tts/inference

# Current documented versions; Timbre v2.0 is deprecated by Gnani.
GNANI_STT_MODEL=gnani-prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5

# STT language codes (English supports Hindi-English mixed audio).
GNANI_STT_LANGUAGES=bn-IN,en-IN,gu-IN,hi-IN,kn-IN,ml-IN,mr-IN,pa-IN,ta-IN,te-IN
GNANI_TTS_LANGUAGES=auto,bn-IN,en-IN,gu-IN,hi-IN,kn-IN,ml-IN,mr-IN,pa-IN,ta-IN,te-IN

# Realtime STT. PCM frame size is 512 samples / 1,024 bytes per Gnani docs.
GNANI_STT_SAMPLE_RATE=16000
GNANI_STT_FRAME_SAMPLES=512
GNANI_STT_FORMAT=verbatim
GNANI_STT_VAD_THRESHOLD=0.6
GNANI_STT_MIN_SILENCE_MS=400
GNANI_STT_MAX_UPLOAD_BYTES=15728640

# Timbre voice selection and audio format (binary WAV output).
GNANI_TTS_VOICE_ENGLISH=Kaveri
GNANI_TTS_VOICE_HINDI=Nalini
GNANI_TTS_VOICE_MARATHI=Zahira
GNANI_TTS_VOICE_TAMIL=Asmita
GNANI_TTS_AUDIO_SAMPLE_RATE=48000
GNANI_TTS_AUDIO_CHANNELS=1
GNANI_TTS_AUDIO_SAMPLE_WIDTH=2
GNANI_TTS_AUDIO_ENCODING=linear_pcm
GNANI_TTS_AUDIO_CONTAINER=wav
GNANI_TTS_SPEED=1

# Maximum duration for Gnani HTTP requests and WebSocket handshakes.
GNANI_REQUEST_TIMEOUT_MS=15000
